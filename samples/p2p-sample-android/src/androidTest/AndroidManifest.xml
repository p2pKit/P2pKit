<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    AGP injects testInstrumentationRunner into the FIRST instrumentation entry.
    Keep the maintained API37 runner first so it cannot replace the supplemental runner.
    The exact final APK runner inventory is checked before a device-runtime driver starts.
  -->
  <instrumentation
      android:name="dev.p2pkit.sample.android.runtime.LanPermissionRuntimeInstrumentation"
      android:targetPackage="dev.p2pkit.sample.android"
      android:functionalTest="true" />
  <instrumentation
      android:name="dev.p2pkit.sample.android.rpclab.RpcLabRuntimeInstrumentation"
      android:targetPackage="dev.p2pkit.sample.android"
      android:functionalTest="true" />
  <instrumentation
      android:name="dev.p2pkit.sample.android.runtime.LanSocketRuntimeInstrumentation"
      android:targetPackage="dev.p2pkit.sample.android"
      android:functionalTest="true" />
  <instrumentation
      android:name="dev.p2pkit.sample.android.runtime.UiAcceptanceInstrumentation"
      android:targetPackage="dev.p2pkit.sample.android"
      android:functionalTest="true" />
  <instrumentation
      android:name="dev.p2pkit.sample.android.runtime.CredentialUiInstrumentation"
      android:targetPackage="dev.p2pkit.sample.android"
      android:functionalTest="true" />
  <instrumentation
      android:name="dev.p2pkit.sample.android.runtime.LegacyTaskPreviewInstrumentation"
      android:targetPackage="dev.p2pkit.sample.android"
      android:functionalTest="true" />
</manifest>

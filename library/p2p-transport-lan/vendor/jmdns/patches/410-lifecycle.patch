+                // fall between the state check and this waiter's registration.
+                _canceling._semaphores.put(thread, semaphore);
+            } finally {
+                this.unlock();
+            }
+            try {
+                long remaining = Math.max(0L, allowance - Math.max(0L, System.nanoTime() - origin));
+                semaphore.tryAcquire(remaining, TimeUnit.NANOSECONDS);
+                return this.isCanceled();
+            } finally {
+                _canceling._semaphores.remove(thread, semaphore);
